{
  "name": "vuetify-bridge",
  "description": "Vuetify components driven by model-algebra models: field inputs, forms and tables",
  "version": "0.1.0",
  "private": false,
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/vuetify-bridge.css"
  },
  "keywords": [
    "vue3",
    "vuetify",
    "model-algebra",
    "component-library",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.27.0",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "prepare": "vite build && vue-tsc -p tsconfig.build.json",
    "lint": "eslint --ext .ts,.vue src",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "model-algebra-common": "github:model-algebra/common-typescript"
  },
  "peerDependencies": {
    "vue": "^3.4.0",
    "vuetify": "^3.5.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "baseline-browser-mapping": "^2.9.11",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-vuetify": "^2.1.2",
    "vitest": "^4.0.16",
    "vue": "^3.5.26",
    "vue-tsc": "^3.2.1",
    "vuetify": "^3.11.6"
  },
  "sideEffects": [
    "*.css"
  ]
}
